# Copy this file to .env and fill in the real values.
# .env is gitignored; this template is committed, so NEVER put real secrets here.

# The Gmail account that authenticates against SMTP and appears as the sender.
SMTP_USER=your-account@gmail.com

# Google account > Security > 2-Step Verification > App passwords.
# Paste the 16 characters with the spaces removed.
SMTP_APP_PASSWORD=your16charapppassword

# Where website enquiries are delivered.
CONTACT_RECIPIENT=destination@example.com

# Comma-separated list of site origins allowed to submit the forms. This stops
# the endpoint being used as an open relay (it CCs the submitter's address).
# Leave unset in local dev; MUST be set in production.
# Example: https://www.example.com,https://example.com
ALLOWED_ORIGINS=

# Optional: per-IP rate limit for form submissions (best-effort, per instance).
# CONTACT_RATE_LIMIT_MAX=5
# CONTACT_RATE_LIMIT_WINDOW_MS=600000
